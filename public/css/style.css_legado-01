/*================== geral ==================*/

@import url('https://fonts.googleapis.com/css2?family=Roboto&display=swap');
/* Cor de fundo do site e fonte*/
body {
    font-family: 'Roboto', sans-serif;
    background-color: #dededed2;
    margin-right: 0px;
}


/*================== menu lateral ==================*/

/* prototipo de menu lateral customizado */
.menu-lateral-msn {
    position: fixed;
    left: 20px;
    top: 40%;
    transform: translateY(-50%);
    width: 150px;
    padding: 20px;
    border: 1px solid black;
}
/* menu lateral padrão */
.menu-lateral-default {
    position: fixed;
    left: 20px;
    top: 40%;
    transform: translateY(-50%);
    width: 150px;
    padding: 20px;
    border: 1px solid #E0E0E0;
    background-color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    z-index: 1;
}
/* Objetos do menu lateral padrão */
.menu-lateral-default ul {
   list-style: none; padding: 0;
}

/* Menu lateral retratil */
.menu-lateral-slide {
    
    position: fixed;
    top: 0%;
    left:0%;
    height: 100%;
    width: 240px;
    padding: 0px;
    background-color: #FFFFFF;
    box-shadow: 3px 0 0 #23007c2f;
    transition: width 0.3s ease;
    overflow: hidden;
    z-index: 1;
}

.menu-lateral-slide.retraido {
  width: 80px; /* reduz a largura */
  height: 100%;
  padding: 0px;
  }

.menu-lateral-slide.retraido ul {
  list-style-type: none; 
  padding: 2px;
  
  
}

.menu-lateral-slide.retraido li {
  padding: 0px 10px;
  transition: background-color 1.0s, font-weight 0.3s, padding 0.4s;
  border: 1px solid #23007c2f;
}

.menu-lateral-slide.retraido li:hover {
  background-color: #002fff42;
    font-weight: bold;
    padding: 0px 5px;
    box-shadow: 3px 0 0 #2f00a55a;
  
}

.menu-lateral-slide.retraido a span {
  
  pointer-events: none;
  visibility: hidden;
  
}

.menu-lateral-slide.retraido i {
    margin: 5px 0px;  
    padding: 5px 5px;
    border-radius: 10px;
    width: 35px;
    border: 1px solid #23007c2f;

}

.btn-expandir {
    margin: 5px 0px;  
    padding: 10px 5px;
    border-radius: 10px;
    width: 35px;
    transition: background-color 1.0s;
}

.btn-expandir:hover {
    background-color: #23007c2f;
    font-weight: bold;
    cursor: pointer;
    
}

.btn-expandir :active {
  border: 2px solid #23007c2f;
  
}

.menu-lateral-slide ul {
   list-style-type: none; 
   padding: 2px;
   font-size: 16px;
   
}

.menu-lateral-slide li {
    padding: 15px 20px;
    transition: background-color 1.0s, font-weight 0.3s, padding 0.4s;
    
}

.menu-lateral-slide li:hover {
    background-color: #002fff42;
    font-weight: bold;
    padding: 15px 5px;
    box-shadow: 3px 0 0 #2f00a55a;
    
}

/*.logoff-section div:hover {
  background-color: #ff0000b8;
  
 }
*/

.menu-lateral-slide a {
  text-decoration: none;
  color: inherit;
  line-height: 30px;
  display: flex;
  gap: 18px;
}

.menu-lateral-slide i {
    font-size: 35px;
    color: #013a73;
    
    
   
}

.titulo-menu {
    display: flex;
    flex-direction: row;
    font-size: 20px;
    color: #013a73;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 20px;
    padding-bottom: 35px;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #b0b0b0;
}

/*================== cards ==================*/

/*Estrutura padrão do tipo card*/
.card {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 2px solid #c0c0c0;
    box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    margin-left: 250px;
    margin-bottom: 20px;
    margin-right: 220px;
    padding: 20px;
}
/* Estrutura card login */
.card-login {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid #d0d0d0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 30px;
    margin: 60px auto;
    max-width: 400px;
}
/* Estrutura card headers */
.card-headers {
    margin-top: -15px;
    margin-bottom: 20px;
    padding-top: 20px;
    padding-bottom: 30px;
    padding-left: 270px;
    padding-right: 250px;
    background-color: #FFFFFF;
    width: 100%vw;
    height: 75px;
    border: 2px solid #c0c0c0;
    box-shadow: 0 3px 0px rgba(0,0,0,0.1);

}
/* Estrutura para o contêiner dos cards de views numericas da home */
.card-views-home-father {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-left: 250px;
  margin-right: 220px;
  
}
/*cards de views numericas da home */
.card-views-home {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid #d0d0d0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-bottom: 20px;
    padding: 30px;
    width: 100px;
    height: 100px;
    
}

.card-static{
    position: relative;
    margin: 20px 250px 80px 220px;
    box-sizing: border-box;
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid #d0d0d0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 40px;

}
/* Titulo do card home */
.titulo-secao {
    font-size: 18px;
    font-weight: bold;
       /* mantém largura e posicionamento originais */
}

.card-interativo {
    margin: 20px 220px 20px 250px;
    box-sizing: border-box;
    background-color: #ceffdb;
    border-radius: 8px;
    border: 3px solid #00d6529d;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 30px;
    font-size: 18px;
    font-weight: bold;
    color: #333333d4;
}

/*================== formulários ==================*/

/* Estilo campos de formulário */
input, textarea, select {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid rgb(165, 165, 165);
   
    padding: 12px;
    margin-bottom: 16px;
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
}


/*================== botões gerais ==================*/

/* Estilo visual botões */
button {
    border-radius: 6px;
    padding: 10px 16px;
    background-color: #013a73; /* azul padrão do LinkedIn, opcional */
    color: white;
    border: none;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
/* Estilos visuais botão voltar */
.button-voltar {
    position: absolute;
    top: 40px;
    left: 20px;
}

.button-voltar.voltar {
    
           display: inline-block;
           padding: 10px 15px;
           background-color: white;
           border: 1px solid black;
           text-decoration: none;
           color: black;
           font-weight: bold;
}
/* Estilo visual botões de aba em settings */
.button-aba-settings{
flex: 1;
padding: 10px;
border: none;
font-weight: bold;
cursor: pointer;
border-bottom: 2px solid black;
background-color: white;
}


/*================== Breadcrumbs ==================*/

/* Estilo visual Breadcrumbs */
.breadcrumbs {
    margin-left: 250px;
    margin-right: 220px;
    margin-top: 40px;
    margin-bottom: 10px;
}
/* Tela atual no breadcrumb - sem link*/
.breadcrumbs-p {
  font-size: 14px;
  color: #555;
}
/* Telas anteriores no breadcrumb - com link*/
.breadcrumbs-a {
  text-decoration: none;
  color: #555;
}


/*================== Footer ==================*/

/* Footer fixo todas as paginas exceto modais */
.footer {
    position: fixed;
    padding: 0px 0px;
    bottom: -1px;
    width: 100%;
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    
}

.footer p {
    text-align: right;
    margin-right: 100px;
    color: #000000;
    font-size: 14px;
    font-weight: bold;  
}


/*================== Tabelas ==================*/

/* Tabela de tarefas */
.tabela-tarefas {
  border-collapse: collapse;
  width: 100%;
  
}

/* Table headers */
.tabela-tarefas th {
  background-color: #e0e0e0;
  padding: 12px;
  text-align: left;
  border-bottom: 2px solid #ddd;
  font-weight: bold;
}

/* Table cells */
.tabela-tarefas td {
  padding: 10px;
  border-bottom: 1px solid #eee;
}
/* Table rows on hover */
.tabela-tarefas tr:hover {
  background-color: #fafafa;
}
/* Linhas (rows) ímpares da tabela */
.tabela-tarefas tbody tr:nth-child(odd) {
  background-color: #ffffff; /* fundo claro */
}
/* Linhas (rows) pares da tabela */
.tabela-tarefas tbody tr:nth-child(even) {
  background-color: #ebebeb; /* fundo mais escuro */
}
/* Recurso visual para tabela vazia */
.sem-tarefas {
  text-align: center;
  font-style: italic;
  color: #777;
}

.sem-tarefas-info{
  margin: 0 220px 50px 220px;
  background-color: #f7f7f7;
  padding: 12px;
  text-align: left;
  border-bottom: 2px solid #ddd;
  font-weight: bold;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);

}


/*================== Objetos de tabela ==================*/

/* Status */
.status {
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: bold;
  color: #fff;
}

.status-concluída { background-color: #5cb85c; }
.status-atrasada { background-color: #f04e4e; }
.status-pendente { background-color: #d69200; }
.status-andamento { background-color: #5f4fec; }

/* Prioridade */
.tag {
  display: inline-block;
  padding: 3px 6px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: bold;
  color: #fff;
  height: 20px;
  width: 60px;
  text-align: center;
}

.prioridade-alta { background-color: #013a73; }
.prioridade-alta::after { content: "🟩"; }
.prioridade-média { background-color: #013a73; }
.prioridade-média::after { content: "🟨"; }
.prioridade-baixa { background-color: #013a73; }
.prioridade-baixa::after { content: "🟥"; }

/* Botões de ação dentro da tabela */
.acoes {
  text-align: center;
}

.btn {
  border: none;
  cursor: pointer;
  margin: 0 2px;
  font-size: 16px;
  padding: 5px 5px;
  border-radius: 8px;
}

.btn.ver { background-color: #3a3a3a; color: #fff; }
.btn.editar { background-color: #013a73; color: #fff; }
.btn.apagar { background-color: #9c0000; color: #fff; }
.btn:hover { opacity: 0.8; }


/*================== Objetos em geral ==================*/

spam {
  color: black;
}

/* Area segura: Bloco invisivel para que objetos não fiquem atrás do footer */
.area-segura {
    padding: 20px;
  }

  /*================== Modais ==================*/

  /* Overlay do modal: Fundo escuro */
 #overlay {
    position: fixed; 
    width: 100vw; height: 100vh; 
    top: 0; left: 0;
    background: rgba(0,0,0,0.5); 
    display: none; 
    justify-content: center; 
    align-items: center;
    z-index: 1;
 }
 /* Conteúdo do modal */
 #modalContent {
    font-size: 14px;
    background: #fff; 
    padding: 20px; 
    border-radius: 8px; 
    top: 5%; left: 40%; 
    max-width: 400px; 
    position: fixed; 
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    max-height: 500px;
    z-index: 1;
    
    
 }

  .inputs-modais {
    background-color: #FFFFFF;
    border-radius: 8px;
    border: 1px solid rgb(234, 6, 6);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 5px;
    margin-bottom: 10px;
    width: 300px;
    height: 30px;
    box-sizing: border-box;
  }

  .radiobox-modais {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;"
  }


  /*================= Splash ===================*/

  /* Splash Screen */
#splash {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: #cacaca;
  color: #333333d4;
  display: block;
  
  align-items: center;
  opacity: 0;
  
  z-index: 9999; /* fica acima de tudo */
}

#splash.active {
  opacity: 1;
}

/* Logo */
#splash .logo {
  width: 120px;
  margin-bottom: 20px;
}

/* Área dos ícones */
.icons {
  display: flex;
  gap: 20px;
  justify-content: center;
  margin-bottom: 20px;
}

.icon-box {
  width: 60px;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;        /* cor da caixa */
  border: 2px solid #013a73; /* borda */
  border-radius: 8px;      /* arredondado */
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  font-size: 2rem;
  opacity: 0;              /* controlado pelo JS */
  transition: opacity 1s ease;
}

#loading-message {
  text-align: center;
  opacity: 0;
  transition: opacity 0.5s ease;
  font-size: 1.2rem;
  margin-top: 20px;
  
}

/* Barra de progresso */
.progress {
  width: 100%;
  height: 30px;
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  margin-top: 20px;
}

.progress-bar {
  width: 0%;
  height: 100%;
  background: #013a73; 
  transition: width 2s ease;
}

/* Card da animação (loading-screen) */
#loading-screen {
  background-color: #FFFFFF;
  border-radius: 8px;
  border: 1px solid #d0d0d0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  padding: 30px;
  max-width: 400px;          /* igual ao login */
  margin: 60px auto;         /* igual ao login */
  opacity: 0;
  transition: opacity 2s ease;
}

#welcome-screen {
  opacity: 0;
  transition: opacity 2s ease;
  font-size: 100px;

  display: flex;
  justify-content: center;   /* centraliza horizontalmente */
  align-items: center;       /* centraliza verticalmente */
  text-align: center;

  /* ocupa toda a área da tela */
  position: fixed;
  top: 0; left: 0;
  width: 100vw;
  height: 100vh;
}

#loading-screen.visible,
#welcome-screen.visible {
  opacity: 1;
}

/* Animação de fade */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Estado inicial da home (usado só na splash) */
.main-content.fade-target {
  opacity: 0;
  transition: opacity 0.1s ease;
}

/* Estado visível com fade */
.main-content.fade-target.visible {
  opacity: 1;
}

